# ================================================
# TaxiApp Backend — Variables de Entorno
# Copia este archivo como .env y rellena los valores
# ================================================

# Puerto (Railway lo provee automáticamente como $PORT)
PORT=3000

# Entorno: development | production
NODE_ENV=development

# ────────────────────────────────────────────────
# Base de datos PostgreSQL (Railway la genera automáticamente)
# En Railway: Settings > Variables > DATABASE_URL se agrega solo
# Formato: postgresql://user:password@host:port/dbname
# ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/taxiapp

# ────────────────────────────────────────────────
# JWT — CAMBIAR EN PRODUCCIÓN
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ────────────────────────────────────────────────
JWT_SECRET=CAMBIA_ESTO_por_una_clave_aleatoria_segura_de_minimo_64_bytes
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ────────────────────────────────────────────────
# Modo Desarrollo
# DEV_MODE=true  → OTP siempre es "0000", credenciales de prueba activas
# DEV_MODE=false → OTP real (requiere Twilio/SendGrid configurado)
# ────────────────────────────────────────────────
DEV_MODE=true

# ────────────────────────────────────────────────
# Rate Limiting
# ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
